# Flask configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=super-secret-development-key-change-in-production
PORT=5000

# Database configuration
# Defaults to SQLite in instance/expense_detector.db
DATABASE_URL=sqlite:///expense_detector.db

# Anomaly Detection & ML settings
ML_MODELS_DIR=instance/models
MIN_TRANSACTIONS_FOR_ML=15
CONTAMINATION_RATE=0.08

# Scheduler configuration
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_HOURS=6
